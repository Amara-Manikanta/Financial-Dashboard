yarn-error.log*
*.log


# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Data & Migration (Sensitive as per user request)
db.json
# Uploaded item photos: personal data, stored on disk, never committed.
db/
# Database backups/exports. These hold full transaction, salary and account
# data, so they must never be committed — one of them was previously pushed
# to a public repository and had to be purged from history.
*.backup
db.json.*
*db-backup*.json
nps_legacy_tx_backup.json
category_rules.json
data.json
# SQLite mirror and its journal/WAL files. Derived from db.json, so it holds
# exactly the same transaction, salary and account data and must never be
# committed either.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
src/data.js
temp_expenses.json
debug_salary.cjs
# Note: this must exclude the directory *contents*, not the directory itself.
# With "scripts/" git never descends into it and the negations below silently
# do nothing.
scripts/*
# ...except the SQLite migration tooling. These are reproducible build steps,
# not one-off scratch scripts, and verify-sqlite.mjs is the safety net that
# proves a migration was faithful — losing it would mean trusting the mirror
# on nothing.
!scripts/sqlite-schema.mjs
!scripts/sqlite-rebuild.mjs
!scripts/migrate-to-sqlite.mjs
!scripts/verify-sqlite.mjs
update_db_structure.py

